rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Admin accounts are marked by an admins/{uid} document, created only
    // with the Admin SDK (never writable from the app).
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Each user can check their own marker; admins can list all admins
    // (Manage Admins screen). Adding/removing goes through the server.
    match /admins/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    // Admin activity log (PDF exports, add/remove admin, opening reports),
    // written only by the server; readable by admins.
    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Profile with age/designation for the usage reports: the owner reads
    // and writes their own; admins read all (Reports screen).
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.age is int
        && request.resource.data.age >= 10 && request.resource.data.age <= 100
        && request.resource.data.designation in
             ['Student', 'Faculty', 'Herbalist', 'Farmer', 'Health worker', 'Others'];
      allow delete: if false;
    }

    // Chatbot activity logs are written only by the server (Admin SDK) in
    // /chat; only admins may read them.
    match /chat_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Per-user daily chat counters, server-only.
    match /chat_usage/{docId} {
      allow read, write: if false;
    }
    // Per-plant rating aggregate (plant_ratings/{plantId}): readable by any
    // signed-in user (so everyone sees the real average), writable only via
    // the transaction in RatingService.submitRating, which also writes the
    // matching userRatings doc below in the same request.
    match /plant_ratings/{plantId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;

      // A user's own rating for this plant. Only that user may write it,
      // and only their own rating value -- never another user's.
      match /userRatings/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // A user's own favorited plants (users/{uid}/favorites/{plantId}) --
    // only that user may ever read or write their own favorites list.
    match /users/{userId}/favorites/{plantId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Collection-group queries (RatingService.getUserReviewCount's
    // collectionGroup('userRatings').where('uid', ...).count() across every
    // plant) are authorized separately from the nested match above -- a
    // rule scoped under a specific parent (plant_ratings/{plantId}/...)
    // does not by itself authorize a cross-collection group query. Same
    // permission as the nested rule, just declared for the group query.
    match /{path=**}/userRatings/{userId} {
      allow read: if request.auth != null;
    }
  }
}
