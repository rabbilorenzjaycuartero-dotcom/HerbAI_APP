rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Per-plant rating aggregate (plant_ratings/{plantId}): readable by any
    // signed-in user (so everyone sees the real average), writable only via
    // the transaction in RatingService.submitRating, which also writes the
    // matching userRatings doc below in the same request.
    match /plant_ratings/{plantId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;

      // A user's own rating for this plant. Only that user may write it,
      // and only their own rating value -- never another user's.
      match /userRatings/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // A user's own favorited plants (users/{uid}/favorites/{plantId}) --
    // only that user may ever read or write their own favorites list.
    match /users/{userId}/favorites/{plantId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Collection-group queries (RatingService.getUserReviewCount's
    // collectionGroup('userRatings').where('uid', ...).count() across every
    // plant) are authorized separately from the nested match above -- a
    // rule scoped under a specific parent (plant_ratings/{plantId}/...)
    // does not by itself authorize a cross-collection group query. Same
    // permission as the nested rule, just declared for the group query.
    match /{path=**}/userRatings/{userId} {
      allow read: if request.auth != null;
    }
  }
}
